rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    // Admin = any signed-in user with a document at /admins/{uid}
    // or a user profile with role === "admin".
    function isAdmin() {
      return signedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        || (
          exists(/databases/$(database)/documents/users/$(request.auth.uid))
          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin"
        )
      );
    }

    match /admins/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if isAdmin();
    }

    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.role == "client";

      allow update: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.role == resource.data.role;
    }

    match /bookings/{bookingId} {
      // Clients can create bookings once signed-in (anonymous sign-in is fine).
      allow create: if signedIn()
        && request.resource.data.status == "Pending"
        && request.resource.data.userId == request.auth.uid;

      // Clients can read their own bookings.
      allow read: if signedIn() && resource.data.userId == request.auth.uid;

      // Admins can fully manage bookings.
      allow read, update, delete: if isAdmin();
    }

    match /services/{serviceId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
  }
}
